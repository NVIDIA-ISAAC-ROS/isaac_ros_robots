<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>unitree_g1_bridge</name>
  <version>4.5.0</version>
  <description>
    Lightweight ROS 2 bridge that converts geometry_msgs/Twist on /cmd_vel
    into unitree_api/msg/Request messages on /api/sport/request for the
    Unitree G1 humanoid robot. Provides a standup service for the
    damp -> stand -> balance-walk transition sequence.
  </description>
  <maintainer email="isaac-ros-maintainers@nvidia.com">Isaac ROS Maintainers</maintainer>
  <license>Apache-2.0</license>

  <build_depend>rosidl_generator_dds_idl</build_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>unitree_api</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
