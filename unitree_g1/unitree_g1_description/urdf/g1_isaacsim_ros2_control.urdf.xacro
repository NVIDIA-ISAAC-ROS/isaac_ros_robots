<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Helper macro for joint interfaces with Isaac Sim topic-based interface. -->
  <xacro:macro name="isaacsim_joint" params="name initial_position:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <command_interface name="effort"/>
      <command_interface name="kp"/>
      <command_interface name="kd"/>
      <!-- State interfaces -->
      <state_interface name="position">
        <param name="initial_value">${initial_position}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <!-- Macro for G1 ros2_control configuration using the Isaac Sim topic-based interface. -->
  <xacro:macro name="g1_isaacsim_ros2_control" params="
    joint_states_topic:=/isaac_joint_states
    joint_commands_topic:=/isaac_joint_commands
    imu_topic:=/isaac_imu">

    <ros2_control name="IsaacSimSystem" type="system">

      <hardware>
        <plugin>isaac_ros_deploy_ros2_control/TopicBasedSystemInterface</plugin>
        <param name="joint_states_topic">${joint_states_topic}</param>
        <param name="joint_commands_topic">${joint_commands_topic}</param>
        <param name="imu_topic">${imu_topic}</param>
      </hardware>

      <!-- Leg Joints -->
      <xacro:isaacsim_joint name="left_hip_pitch_joint"/>
      <xacro:isaacsim_joint name="right_hip_pitch_joint"/>
      <xacro:isaacsim_joint name="left_hip_roll_joint"/>
      <xacro:isaacsim_joint name="right_hip_roll_joint"/>
      <xacro:isaacsim_joint name="left_hip_yaw_joint"/>
      <xacro:isaacsim_joint name="right_hip_yaw_joint"/>
      <xacro:isaacsim_joint name="left_knee_joint"/>
      <xacro:isaacsim_joint name="right_knee_joint"/>
      <xacro:isaacsim_joint name="left_ankle_pitch_joint"/>
      <xacro:isaacsim_joint name="right_ankle_pitch_joint"/>
      <xacro:isaacsim_joint name="left_ankle_roll_joint"/>
      <xacro:isaacsim_joint name="right_ankle_roll_joint"/>

      <!-- Waist Joints -->
      <xacro:isaacsim_joint name="waist_yaw_joint"/>
      <xacro:isaacsim_joint name="waist_roll_joint"/>
      <xacro:isaacsim_joint name="waist_pitch_joint"/>

      <!-- Arm Joints -->
      <xacro:isaacsim_joint name="left_shoulder_pitch_joint"/>
      <xacro:isaacsim_joint name="right_shoulder_pitch_joint"/>
      <xacro:isaacsim_joint name="left_shoulder_roll_joint"/>
      <xacro:isaacsim_joint name="right_shoulder_roll_joint"/>
      <xacro:isaacsim_joint name="left_shoulder_yaw_joint"/>
      <xacro:isaacsim_joint name="right_shoulder_yaw_joint"/>
      <xacro:isaacsim_joint name="left_elbow_joint"/>
      <xacro:isaacsim_joint name="right_elbow_joint"/>

      <!-- Wrist Joints -->
      <xacro:isaacsim_joint name="left_wrist_roll_joint"/>
      <xacro:isaacsim_joint name="right_wrist_roll_joint"/>
      <xacro:isaacsim_joint name="left_wrist_pitch_joint"/>
      <xacro:isaacsim_joint name="right_wrist_pitch_joint"/>
      <xacro:isaacsim_joint name="left_wrist_yaw_joint"/>
      <xacro:isaacsim_joint name="right_wrist_yaw_joint"/>

      <!-- Left Hand Finger Joints -->
      <xacro:isaacsim_joint name="left_hand_thumb_0_joint"/>
      <xacro:isaacsim_joint name="left_hand_thumb_1_joint"/>
      <xacro:isaacsim_joint name="left_hand_thumb_2_joint"/>
      <xacro:isaacsim_joint name="left_hand_middle_0_joint"/>
      <xacro:isaacsim_joint name="left_hand_middle_1_joint"/>
      <xacro:isaacsim_joint name="left_hand_index_0_joint"/>
      <xacro:isaacsim_joint name="left_hand_index_1_joint"/>

      <!-- Right Hand Finger Joints -->
      <xacro:isaacsim_joint name="right_hand_thumb_0_joint"/>
      <xacro:isaacsim_joint name="right_hand_thumb_1_joint"/>
      <xacro:isaacsim_joint name="right_hand_thumb_2_joint"/>
      <xacro:isaacsim_joint name="right_hand_middle_0_joint"/>
      <xacro:isaacsim_joint name="right_hand_middle_1_joint"/>
      <xacro:isaacsim_joint name="right_hand_index_0_joint"/>
      <xacro:isaacsim_joint name="right_hand_index_1_joint"/>

      <!-- IMU Sensor -->
      <sensor name="imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>

    </ros2_control>

  </xacro:macro>

</robot>
